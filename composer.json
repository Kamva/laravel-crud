{
    "name": "kamva/laravel-crud",
    "description": "CRUD manager system",
    "keywords": ["laravel", "kamva", "crud", "crud manager"],
    "license": "MIT",
    "authors": [
        {
            "name": "Mehdi Meshkatian",
            "email": "mmeshkatian@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "laravel/framework": "^10.0|^11.0|^12.0",
        "maatwebsite/excel": "^3.1"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Kamva\\Crud\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kamva\\Crud\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/Stubs",
            "tests/Performance/Fixtures.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kamva\\Crud\\KamvaCRUDServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "bench": "@php -d opcache.enable_cli=1 vendor/bin/phpunit --testsuite performance --order-by=default --no-progress"
    }
}
